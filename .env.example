# Used by docker-compose (variable substitution only, never copied into the image)

# Written by ./scripts/compute-mem-limit.sh (80% of currently available RAM)
TANK_MEM_LIMIT=640m
TANK_HEAP_MB=384

# Origins allowed to open a Socket.IO connection (comma-separated)
ALLOWED_ORIGINS=https://tank.amsoft.am

# true (default) = generate walls/water/trees in Open World, false = empty map
ADD_MAP_OBJECTS=true

# Capacity limits
OPEN_WORLD_MAX_PLAYERS=64
MAX_ROOMS=30
MAX_CONNECTIONS_PER_IP=8
